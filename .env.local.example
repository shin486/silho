# Neon PostgreSQL connection string (pooled or direct)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"

# Public app origin (used by Better Auth)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional (recommended): Hugging Face access token for higher ZeroGPU quota on AI Virtual Try-On
HF_TOKEN=""

# Set to "true" locally to bypass the 3/day AI Try-On rate limit during testing (keep "false" in production)
TRYON_UNLIMITED="false"

