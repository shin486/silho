# Neon PostgreSQL connection string (pooled or direct)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"

# Public app origin (used by Better Auth)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional (recommended): Hugging Face access token for higher ZeroGPU quota on AI Virtual Try-On
HF_TOKEN=""

# Optional: Private GPU FastAPI server URL (Google Colab T4 / Kaggle T4x2 via Cloudflare Tunnel)
# Supports both FitDiT HD (`scripts/vton-server/fitdit_server.py`, auto-detected via /health)
# and FASHN VTON 1.5 (`scripts/vton-server/server.py`).
VTON_API_URL=""
# Optional shared secret sent in the `x-vton-secret` header to protect your private VTON server
VTON_API_SECRET=""
# Optional: set to "vton-api" to run your private GPU server (e.g. FitDiT HD) FIRST before WeShopAI.
# Default ("weshop") tries WeShopAI (1520x2048) first and automatically falls back to VTON_API_URL.
TRYON_PRIMARY_ENGINE="weshop"

# Set to "true" locally to bypass the 3/day AI Try-On rate limit during testing (keep "false" in production)
TRYON_UNLIMITED="false"

